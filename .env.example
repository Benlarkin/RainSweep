# Copy to .env.local and fill in. Never commit real values.

# Google Cloud OAuth 2.0 client (type: Web application).
# Authorized redirect URI must be: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of the app, no trailing slash.
APP_URL=http://localhost:3000

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
